{
  "app-id": "com.ubik.panthesia",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "panthesia",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/panthesia/cargo"
    }
  },
  "modules": [
    {
      "name": "panthesia",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir .cargo",
        "cp ./flatpak/cargo-config.toml .cargo/config.toml",
        "cargo --offline build --release",
        "mkdir -p /app/share/panthesia/",
        "cp -ap ./default.sf2 /app/share/panthesia/default.sf2",
        "install -Dm755 ./target/release/panthesia -t /app/bin/",
        "install -Dm644 ./flatpak/com.ubik.panthesia.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 ./flatpak/com.ubik.panthesia.desktop -t /app/share/applications/",
        "install -Dm644 ./flatpak/com.ubik.panthesia.png -t /app/share/icons/hicolor/256x256/apps/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/PolyMeilex/Neothesia.git",
          "tag": "v0.4.0",
          "commit": "..."
        },
        {
          "type": "archive",
          "url": "https://github.com/flathub/com.ubik.panthesia/releases/download/0.4.0-vendor/vendor.tar.xz",
          "sha256": "...",
          "dest": "vendor"
        }
      ]
    }
  ]
}
