{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panthesia",
  "version": "0.1.0",
  "identifier": "com.ubik.panthesia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Panthesia",
        "width": 1440,
        "height": 960,
        "minWidth": 760,
        "minHeight": 620,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mid",
          "midi",
          "kar"
        ],
        "name": "MIDI",
        "description": "MIDI 演奏文件",
        "role": "Viewer"
      },
      {
        "ext": [
          "musicxml",
          "mxl"
        ],
        "name": "MusicXML",
        "description": "MusicXML 乐谱",
        "role": "Viewer"
      },
      {
        "ext": [
          "abc"
        ],
        "name": "ABC",
        "description": "ABC 记谱",
        "role": "Viewer"
      },
      {
        "ext": [
          "panthesia"
        ],
        "name": "Panthesia",
        "description": "Panthesia 歌曲清单",
        "role": "Editor"
      }
    ],
    "resources": {
      "../../default.sf2": "default.sf2"
    }
  }
}
